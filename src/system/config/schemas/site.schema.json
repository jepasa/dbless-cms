{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "template",
    "settings"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        2
      ]
    },
    "template": {
      "type": "string",
      "maxLength": 64
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "siteLocale",
        "adminLocale",
        "name",
        "slogan",
        "description",
        "baseUrl",
        "canonical",
        "favicon",
        "logo",
        "featuredImage",
        "author",
        "keywords",
        "type",
        "image",
        "imageAlt",
        "imageType",
        "imageWidth",
        "imageHeight",
        "contact"
      ],
      "properties": {
        "siteLocale": {
          "type": "string",
          "maxLength": 300
        },
        "adminLocale": {
          "type": "string",
          "maxLength": 300
        },
        "name": {
          "type": "string",
          "maxLength": 300
        },
        "slogan": {
          "type": "string",
          "maxLength": 300
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "baseUrl": {
          "type": "string",
          "maxLength": 2048
        },
        "canonical": {
          "type": "string",
          "maxLength": 2048
        },
        "favicon": {
          "type": "string",
          "maxLength": 300
        },
        "logo": {
          "type": "string",
          "maxLength": 300
        },
        "featuredImage": {
          "type": "string",
          "maxLength": 300
        },
        "author": {
          "type": "string",
          "maxLength": 300
        },
        "keywords": {
          "type": "string",
          "maxLength": 1000
        },
        "type": {
          "type": "string",
          "maxLength": 300
        },
        "image": {
          "type": "string",
          "maxLength": 300
        },
        "imageAlt": {
          "type": "string",
          "maxLength": 300
        },
        "imageType": {
          "type": "string",
          "maxLength": 300,
          "enum": [
            "",
            "image/png",
            "image/jpeg",
            "image/webp",
            "image/avif",
            "image/gif",
            "image/svg+xml",
            "image/x-icon"
          ]
        },
        "imageWidth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16384
        },
        "imageHeight": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16384
        },
        "contact": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "country",
            "state",
            "city",
            "phone",
            "email",
            "responsible"
          ],
          "properties": {
            "country": {
              "type": "string",
              "maxLength": 300
            },
            "state": {
              "type": "string",
              "maxLength": 300
            },
            "city": {
              "type": "string",
              "maxLength": 300
            },
            "phone": {
              "type": "string",
              "maxLength": 300
            },
            "email": {
              "type": "string",
              "maxLength": 300
            },
            "responsible": {
              "type": "string",
              "maxLength": 300
            }
          }
        }
      }
    }
  }
}

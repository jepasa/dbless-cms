{
  "id": "homepage",
  "name": "Homepage",
  "description": "Manage exclusive scheduled homepages with safe HTML/Mustache or linked public plugin content.",
  "version": "1.1.0",
  "api": 1,
  "cmsMajor": 2,
  "entry": "Plugin.php",
  "class": "DBLESSCMS\\HomepagePlugin",
  "assets": {
    "css": "css/homepage.css",
    "js": "js/homepage.js",
    "icon": "homepage.svg"
  },
  "defaults": {},
  "router": "Router.php",
  "routes": {
    "overview": {
      "title": "homepage.overview",
      "file": "pages/catalog.php",
      "requiresEnabled": true,
      "visibility": "private"
    },
    "editor": {
      "title": "homepage.editor",
      "file": "pages/workspace.php",
      "requiresEnabled": true,
      "visibility": "private"
    },
    "history": {
      "title": "homepage.history",
      "file": "pages/catalog.php",
      "requiresEnabled": true,
      "visibility": "private"
    },
    "preview": {
      "title": "homepage.preview",
      "file": "pages/workspace.php",
      "requiresEnabled": true,
      "visibility": "private"
    },
    "new": {
      "title": "homepage.new",
      "file": "pages/catalog.php",
      "requiresEnabled": true,
      "visibility": "private"
    },
    "trash": {
      "title": "homepage.trash",
      "file": "pages/catalog.php",
      "requiresEnabled": true,
      "visibility": "private"
    }
  },
  "navigation": {
    "label": "homepage.name",
    "items": [
      {
        "label": "homepage.overview",
        "route": "overview"
      },
      {
        "label": "homepage.new",
        "route": "new"
      },
      {
        "separator": true
      },
      {
        "label": "homepage.history",
        "route": "history"
      },
      {
        "separator": true
      },
      {
        "label": "homepage.trash",
        "route": "trash"
      }
    ]
  },
  "configuration": false,
  "presentation": "about.json"
}

{
  "id": "slides",
  "name": "Slides",
  "description": "Conjuntos de banners, carrosséis, depoimentos e faixas rotativas.",
  "version": "1.2.0",
  "api": 1,
  "cmsMajor": 2,
  "entry": "Plugin.php",
  "class": "DBLESSCMS\\SlidesPlugin",
  "assets": {
    "css": "css/slides.css",
    "js": "js/slides.js",
    "icon": "slides.svg"
  },
  "defaults": {},
  "router": "Router.php",
  "routes": {
    "overview": {
      "title": "slides.overview",
      "file": "pages/workspace.php",
      "requiresEnabled": true,
      "visibility": "private"
    },
    "editor": {
      "title": "slides.editor",
      "file": "pages/workspace.php",
      "requiresEnabled": true,
      "visibility": "private"
    },
    "locations": {
      "title": "slides.locations",
      "file": "pages/workspace.php",
      "requiresEnabled": true,
      "visibility": "private"
    },
    "trash": {
      "title": "slides.trash",
      "file": "pages/workspace.php",
      "requiresEnabled": true,
      "visibility": "private"
    },
    "history": {
      "title": "slides.history",
      "file": "pages/workspace.php",
      "requiresEnabled": false,
      "visibility": "private"
    }
  },
  "navigation": {
    "label": "slides.name",
    "items": [
      {
        "label": "slides.overview",
        "route": "overview"
      },
      {
        "label": "slides.new",
        "route": "editor"
      },
      {
        "separator": true
      },
      {
        "label": "slides.history",
        "route": "history"
      },
      {
        "separator": true
      },
      {
        "label": "slides.trash",
        "route": "trash"
      }
    ]
  },
  "configuration": false,
  "contentServices": {
    "location": {
      "api": 1,
      "description": "Published slide items bound to a registered template location.",
      "context": "block",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key"
        ],
        "properties": {
          "key": {
            "type": "string",
            "maxLength": 48
          }
        }
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "title",
                "text",
                "href",
                "image"
              ],
              "properties": {
                "title": {
                  "type": "string",
                  "maxLength": 12000
                },
                "text": {
                  "type": "string",
                  "maxLength": 12000
                },
                "href": {
                  "type": "string",
                  "maxLength": 12000
                },
                "image": {
                  "type": "string",
                  "maxLength": 12000
                }
              }
            }
          }
        }
      },
      "formats": [
        "cards",
        "list"
      ]
    },
    "data": {
      "api": 1,
      "description": "Full enabled items and playback settings of a published slide location.",
      "context": "block",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key"
        ],
        "properties": {
          "key": {
            "type": "string",
            "maxLength": 48
          }
        }
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "contentType",
          "type",
          "autoplay",
          "interval",
          "items"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 160
          },
          "contentType": {
            "type": "string",
            "maxLength": 40
          },
          "type": {
            "type": "string",
            "maxLength": 40
          },
          "autoplay": {
            "type": "boolean"
          },
          "interval": {
            "type": "integer",
            "minimum": 3000,
            "maximum": 30000
          },
          "items": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "title",
                "text",
                "image",
                "alt",
                "href",
                "label",
                "attribution",
                "price"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "maxLength": 64
                },
                "title": {
                  "type": "string",
                  "maxLength": 200
                },
                "text": {
                  "type": "string",
                  "maxLength": 2000
                },
                "image": {
                  "type": "string",
                  "maxLength": 2048
                },
                "alt": {
                  "type": "string",
                  "maxLength": 300
                },
                "href": {
                  "type": "string",
                  "maxLength": 2048
                },
                "label": {
                  "type": "string",
                  "maxLength": 100
                },
                "attribution": {
                  "type": "string",
                  "maxLength": 200
                },
                "price": {
                  "type": "string",
                  "maxLength": 80
                }
              }
            }
          }
        }
      },
      "formats": [
        "data"
      ]
    }
  },
  "presentation": "about.json"
}

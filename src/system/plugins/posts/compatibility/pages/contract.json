    "list": {
      "api": 1,
      "description": "List published pages; home, 404 and drafts are excluded.",
      "context": "block",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12,
            "default": 3
          }
        }
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "title",
                "text",
                "href",
                "image"
              ],
              "properties": {
                "title": {
                  "type": "string",
                  "maxLength": 12000
                },
                "text": {
                  "type": "string",
                  "maxLength": 12000
                },
                "href": {
                  "type": "string",
                  "maxLength": 12000
                },
                "image": {
                  "type": "string",
                  "maxLength": 12000
                }
              }
            }
          }
        }
      },
      "formats": [
        "cards",
        "list"
      ]
    },

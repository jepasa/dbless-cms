{
  "id": "menu",
  "name": "Menu",
  "description": "Gestão de menus e submenus dos templates públicos.",
  "version": "1.2.0",
  "api": 1,
  "cmsMajor": 2,
  "entry": "Plugin.php",
  "class": "DBLESSCMS\\MenuPlugin",
  "assets": {
    "css": "css/menu.css",
    "js": "js/menu.js",
    "icon": "menu.svg"
  },
  "defaults": {},
  "router": "Router.php",
  "routes": {
    "overview": {
      "title": "menu.overview",
      "file": "pages/workspace.php",
      "requiresEnabled": true,
      "visibility": "private"
    },
    "editor": {
      "title": "menu.editor",
      "file": "pages/workspace.php",
      "requiresEnabled": true,
      "visibility": "private"
    },
    "locations": {
      "title": "menu.locations",
      "file": "pages/workspace.php",
      "requiresEnabled": true,
      "visibility": "private"
    },
    "trash": {
      "title": "menu.trash",
      "file": "pages/workspace.php",
      "requiresEnabled": true,
      "visibility": "private"
    },
    "history": {
      "title": "menu.history",
      "file": "pages/workspace.php",
      "requiresEnabled": false,
      "visibility": "private"
    }
  },
  "navigation": {
    "label": "menu.name",
    "items": [
      {
        "label": "menu.overview",
        "route": "overview"
      },
      {
        "label": "menu.new",
        "route": "editor"
      },
      {
        "separator": true
      },
      {
        "label": "menu.history",
        "route": "history"
      },
      {
        "separator": true
      },
      {
        "label": "menu.trash",
        "route": "trash"
      }
    ]
  },
  "configuration": false,
  "contentServices": {
    "location": {
      "api": 1,
      "description": "Public menu links from a registered location, including descendant links.",
      "context": "block",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key"
        ],
        "properties": {
          "key": {
            "type": "string",
            "maxLength": 48
          }
        }
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "title",
                "text",
                "href",
                "image"
              ],
              "properties": {
                "title": {
                  "type": "string",
                  "maxLength": 12000
                },
                "text": {
                  "type": "string",
                  "maxLength": 12000
                },
                "href": {
                  "type": "string",
                  "maxLength": 12000
                },
                "image": {
                  "type": "string",
                  "maxLength": 12000
                }
              }
            }
          }
        }
      },
      "formats": [
        "list"
      ]
    },
    "tree": {
      "api": 1,
      "description": "Published menu tree with nested children, never hidden/draft page links.",
      "context": "block",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key"
        ],
        "properties": {
          "key": {
            "type": "string",
            "maxLength": 48
          }
        }
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "name",
          "type"
        ],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label",
                "href",
                "slug",
                "anchor",
                "newTab",
                "children"
              ],
              "properties": {
                "label": {
                  "type": "string",
                  "maxLength": 200
                },
                "href": {
                  "type": "string",
                  "maxLength": 2048
                },
                "slug": {
                  "type": "string",
                  "maxLength": 64
                },
                "anchor": {
                  "type": "string",
                  "maxLength": 64
                },
                "newTab": {
                  "type": "boolean"
                },
                "children": {
                  "type": "array",
                  "maxItems": 100,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "label",
                      "href",
                      "slug",
                      "anchor",
                      "newTab",
                      "children"
                    ],
                    "properties": {
                      "label": {
                        "type": "string",
                        "maxLength": 200
                      },
                      "href": {
                        "type": "string",
                        "maxLength": 2048
                      },
                      "slug": {
                        "type": "string",
                        "maxLength": 64
                      },
                      "anchor": {
                        "type": "string",
                        "maxLength": 64
                      },
                      "newTab": {
                        "type": "boolean"
                      },
                      "children": {
                        "type": "array",
                        "maxItems": 100,
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "label",
                            "href",
                            "slug",
                            "anchor",
                            "newTab",
                            "children"
                          ],
                          "properties": {
                            "label": {
                              "type": "string",
                              "maxLength": 200
                            },
                            "href": {
                              "type": "string",
                              "maxLength": 2048
                            },
                            "slug": {
                              "type": "string",
                              "maxLength": 64
                            },
                            "anchor": {
                              "type": "string",
                              "maxLength": 64
                            },
                            "newTab": {
                              "type": "boolean"
                            },
                            "children": {
                              "type": "array",
                              "maxItems": 100,
                              "items": {
                                "type": "object",
                                "additionalProperties": false,
                                "required": [
                                  "label",
                                  "href",
                                  "slug",
                                  "anchor",
                                  "newTab",
                                  "children"
                                ],
                                "properties": {
                                  "label": {
                                    "type": "string",
                                    "maxLength": 200
                                  },
                                  "href": {
                                    "type": "string",
                                    "maxLength": 2048
                                  },
                                  "slug": {
                                    "type": "string",
                                    "maxLength": 64
                                  },
                                  "anchor": {
                                    "type": "string",
                                    "maxLength": 64
                                  },
                                  "newTab": {
                                    "type": "boolean"
                                  },
                                  "children": {
                                    "type": "array",
                                    "maxItems": 100,
                                    "items": {
                                      "type": "object",
                                      "additionalProperties": false,
                                      "required": [
                                        "label",
                                        "href",
                                        "slug",
                                        "anchor",
                                        "newTab",
                                        "children"
                                      ],
                                      "properties": {
                                        "label": {
                                          "type": "string",
                                          "maxLength": 200
                                        },
                                        "href": {
                                          "type": "string",
                                          "maxLength": 2048
                                        },
                                        "slug": {
                                          "type": "string",
                                          "maxLength": 64
                                        },
                                        "anchor": {
                                          "type": "string",
                                          "maxLength": 64
                                        },
                                        "newTab": {
                                          "type": "boolean"
                                        },
                                        "children": {
                                          "type": "array",
                                          "maxItems": 100,
                                          "items": {
                                            "type": "object",
                                            "additionalProperties": false,
                                            "required": [],
                                            "properties": {}
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "name": {
            "type": "string",
            "maxLength": 500
          },
          "type": {
            "type": "string",
            "maxLength": 48
          }
        }
      },
      "formats": [
        "data"
      ]
    }
  },
  "presentation": "about.json"
}

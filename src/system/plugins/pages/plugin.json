    "list": {
      "api": 1,
      "description": "List published pages; home, 404 and drafts are excluded.",
      "context": "block",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12,
            "default": 3
          }
        }
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "title",
                "text",
                "href",
                "image"
              ],
              "properties": {
                "title": {
                  "type": "string",
                  "maxLength": 12000
                },
                "text": {
                  "type": "string",
                  "maxLength": 12000
                },
                "href": {
                  "type": "string",
                  "maxLength": 12000
                },
                "image": {
                  "type": "string",
                  "maxLength": 12000
                }
              }
            }
          }
        }
      },
      "formats": [
        "cards",
        "list"
      ]
    },
    "records": {
      "api": 1,
      "description": "Published page summaries, stable IDs, editorial fields and explicit pagination; never drafts or rendered HTML.",
      "context": "block",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 12
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000,
            "default": 1
          },
          "sort": {
            "type": "string",
            "maxLength": 10,
            "enum": [
              "title",
              "updatedAt"
            ],
            "default": "title"
          },
          "direction": {
            "type": "string",
            "maxLength": 4,
            "enum": [
              "asc",
              "desc"
            ],
            "default": "asc"
          }
        }
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "total",
          "page",
          "pages"
        ],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "title",
                "summary",
                "url",
                "image",
                "parentId",
                "createdAt",
                "updatedAt",
                "isCurrent"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "maxLength": 64
                },
                "title": {
                  "type": "string",
                  "maxLength": 200
                },
                "summary": {
                  "type": "string",
                  "maxLength": 500
                },
                "url": {
                  "type": "string",
                  "maxLength": 2048
                },
                "image": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "url",
                    "alt"
                  ],
                  "properties": {
                    "url": {
                      "type": "string",
                      "maxLength": 2048
                    },
                    "alt": {
                      "type": "string",
                      "maxLength": 500
                    }
                  }
                },
                "parentId": {
                  "type": "string",
                  "maxLength": 64
                },
                "createdAt": {
                  "type": "string",
                  "maxLength": 30
                },
                "updatedAt": {
                  "type": "string",
                  "maxLength": 30
                },
                "isCurrent": {
                  "type": "boolean"
                }
              }
            }
          },
          "total": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "pages": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          }
        }
      },
      "formats": []
    },

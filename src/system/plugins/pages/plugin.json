{
  "id": "pages",
  "name": "Páginas",
  "description": "Gerenciamento de páginas, rascunhos, publicação e histórico.",
  "version": "1.3.1",
  "api": 1,
  "cmsMajor": 2,
  "entry": "Plugin.php",
  "class": "DBLESSCMS\\PagesPlugin",
  "assets": {
    "css": "css/pages.css",
    "js": "js/pages.js",
    "icon": "pages.svg"
  },
  "defaults": {
    "browser": {
      "pageSize": 25
    }
  },
  "router": "Router.php",
  "routes": {
    "overview": {
      "title": "nav.pages",
      "file": "pages/workspace.php",
      "requiresEnabled": true,
      "visibility": "private"
    },
    "new": {
      "title": "pages.new",
      "file": "pages/workspace.php",
      "requiresEnabled": true,
      "visibility": "private"
    },
    "editor": {
      "title": "nav.edit",
      "file": "pages/workspace.php",
      "requiresEnabled": true,
      "visibility": "private"
    },
    "trash": {
      "title": "pages.trash",
      "file": "pages/workspace.php",
      "requiresEnabled": true,
      "visibility": "private"
    },
    "history": {
      "title": "nav.history",
      "file": "pages/workspace.php",
      "requiresEnabled": false,
      "visibility": "private"
    },
    "preview": {
      "title": "editor.preview",
      "file": "pages/workspace.php",
      "requiresEnabled": true,
      "visibility": "private"
    },
    "settings": {
      "title": "pages.settings",
      "file": "pages/settings.php",
      "requiresEnabled": false,
      "visibility": "private"
    }
  },
  "navigation": {
    "label": "nav.pages",
    "items": [
      {
        "label": "pages.overview",
        "route": "overview"
      },
      {
        "label": "pages.new",
        "route": "new"
      },
      {
        "separator": true
      },
      {
        "label": "nav.history",
        "route": "history"
      },
      {
        "separator": true
      },
      {
        "label": "pages.settings",
        "route": "settings"
      },
      {
        "separator": true
      },
      {
        "label": "pages.trash",
        "route": "trash"
      }
    ]
  },
  "configuration": "settings",
  "presentation": "about.json",

{
  "id": "pages",
  "name": "Páginas",
  "description": "Gerenciamento de páginas, rascunhos, publicação e histórico.",
  "version": "1.2.0",
  "api": 1,
  "cmsMajor": 2,
  "entry": "Plugin.php",
  "class": "DBLESSCMS\\PagesPlugin",
  "assets": {
    "css": "css/pages.css",
    "js": "js/pages.js",
    "icon": "pages.svg"
  },
  "defaults": {},
  "router": "Router.php",
  "routes": {
    "overview": {
      "title": "nav.pages",
      "file": "pages/workspace.php",
      "requiresEnabled": true,
      "visibility": "private"
    },
    "new": {
      "title": "pages.new",
      "file": "pages/workspace.php",
      "requiresEnabled": true,
      "visibility": "private"
    },
    "editor": {
      "title": "nav.edit",
      "file": "pages/workspace.php",
      "requiresEnabled": true,
      "visibility": "private"
    },
    "trash": {
      "title": "pages.trash",
      "file": "pages/workspace.php",
      "requiresEnabled": true,
      "visibility": "private"
    },
    "history": {
      "title": "nav.history",
      "file": "pages/workspace.php",
      "requiresEnabled": false,
      "visibility": "private"
    },
    "preview": {
      "title": "editor.preview",
      "file": "pages/workspace.php",
      "requiresEnabled": true,
      "visibility": "private"
    }
  },
  "navigation": {
    "label": "nav.pages",
    "items": [
      {
        "label": "pages.overview",
        "route": "overview"
      },
      {
        "label": "pages.new",
        "route": "new"
      },
      {
        "separator": true
      },
      {
        "label": "nav.history",
        "route": "history"
      },
      {
        "separator": true
      },
      {
        "label": "pages.trash",
        "route": "trash"
      }
    ]
  },
  "configuration": false,
  "presentation": "about.json",
  "contentServices": {
    "list": {
      "api": 1,
      "description": "List published pages; home, 404 and drafts are excluded.",
      "context": "block",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12,
            "default": 3
          }
        }
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "title",
                "text",
                "href",
                "image"
              ],
              "properties": {
                "title": {
                  "type": "string",
                  "maxLength": 12000
                },
                "text": {
                  "type": "string",
                  "maxLength": 12000
                },
                "href": {
                  "type": "string",
                  "maxLength": 12000
                },
                "image": {
                  "type": "string",
                  "maxLength": 12000
                }
              }
            }
          }
        }
      },
      "formats": [
        "cards",
        "list"
      ]
    }
  },
  "documentSource": {
    "api": 1,
    "description": "Published ordinary Pages content, without the site frame."
  }
}

{
  "id": "files-manager",
  "name": "Gerenciador de arquivos",
  "version": "1.1.0",
  "api": 1,
  "cmsMajor": 2,
  "entry": "Plugin.php",
  "class": "DBLESSCMS\\FilesManager",
  "launcher": "files",
  "assets": {
    "css": "css/files-manager.css",
    "js": "js/files-manager.js",
    "icon": "files-manager.svg"
  },
  "defaults": {
    "uploads": {
      "public": "media",
      "private": "media"
    }
  },
  "router": "Router.php",
  "routes": {
    "overview": {
      "title": "fm.overview",
      "description": "fm.overviewHelp",
      "file": "pages/overview.php",
      "requiresEnabled": true,
      "visibility": "private"
    },
    "settings": {
      "title": "fm.settings",
      "description": "fm.settingsHelp",
      "file": "pages/settings.php",
      "requiresEnabled": false,
      "visibility": "private"
    },
    "trash": {
      "title": "fm.trash",
      "description": "fm.trashHelp",
      "file": "pages/trash.php",
      "requiresEnabled": true,
      "visibility": "private"
    },
    "history": {
      "title": "fm.history",
      "file": "pages/history.php",
      "requiresEnabled": false,
      "visibility": "private"
    },
    "rights": {
      "title": "fm.rights",
      "file": "pages/rights.php",
      "requiresEnabled": true,
      "visibility": "private"
    }
  },
  "navigation": {
    "label": "fm.menu",
    "items": [
      {
        "label": "fm.overview",
        "route": "overview"
      },
      {
        "label": "fm.rights",
        "route": "rights"
      },
      {
        "separator": true
      },
      {
        "label": "fm.history",
        "route": "history"
      },
      {
        "separator": true
      },
      {
        "label": "fm.settings",
        "route": "settings"
      },
      {
        "separator": true
      },
      {
        "label": "fm.trash",
        "route": "trash"
      }
    ]
  },
  "configuration": "settings",
  "description": "Gerenciamento de arquivos públicos e privados, uploads e lixeira.",
  "presentation": "about.json",
  "contentServices": {
    "asset": {
      "api": 1,
      "description": "An approved public image and public provenance; private evidence is never returned.",
      "context": "block",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 30
          }
        }
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "src",
          "author",
          "source",
          "license",
          "licenseUrl",
          "credit",
          "altSuggestion",
          "width",
          "height"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 30
          },
          "src": {
            "type": "string",
            "maxLength": 2048
          },
          "author": {
            "type": "string",
            "maxLength": 300
          },
          "source": {
            "type": "string",
            "maxLength": 2048
          },
          "license": {
            "type": "string",
            "maxLength": 30
          },
          "licenseUrl": {
            "type": "string",
            "maxLength": 2048
          },
          "credit": {
            "type": "string",
            "maxLength": 1000
          },
          "altSuggestion": {
            "type": "string",
            "maxLength": 1000
          },
          "width": {
            "type": "integer",
            "minimum": 1,
            "maximum": 40000000
          },
          "height": {
            "type": "integer",
            "minimum": 1,
            "maximum": 40000000
          }
        }
      },
      "formats": [
        "data"
      ]
    }
  }
}

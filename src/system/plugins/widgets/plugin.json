{
  "id": "widgets",
  "name": "Widgets",
  "description": "Template-defined key/value content slots.",
  "version": "1.2.0",
  "api": 1,
  "cmsMajor": 2,
  "entry": "Plugin.php",
  "class": "DBLESSCMS\\WidgetsPlugin",
  "assets": {
    "css": "css/widgets.css",
    "js": "js/widgets.js",
    "icon": "widgets.svg"
  },
  "defaults": {},
  "router": "Router.php",
  "routes": {
    "overview": {
      "title": "widgets.overview",
      "file": "pages/workspace.php",
      "requiresEnabled": true,
      "visibility": "private"
    },
    "editor": {
      "title": "widgets.editor",
      "file": "pages/workspace.php",
      "requiresEnabled": true,
      "visibility": "private"
    },
    "history": {
      "title": "widgets.history",
      "file": "pages/workspace.php",
      "requiresEnabled": false,
      "visibility": "private"
    },
    "trash": {
      "title": "widgets.trash",
      "file": "pages/workspace.php",
      "requiresEnabled": true,
      "visibility": "private"
    },
    "library": {
      "title": "widgets.library",
      "file": "pages/library.php",
      "requiresEnabled": true,
      "visibility": "private"
    },
    "record": {
      "title": "widgets.record",
      "file": "pages/library.php",
      "requiresEnabled": true,
      "visibility": "private"
    },
    "sets": {
      "title": "widgets.sets",
      "file": "pages/library.php",
      "requiresEnabled": true,
      "visibility": "private"
    },
    "set": {
      "title": "widgets.setEditor",
      "file": "pages/library.php",
      "requiresEnabled": true,
      "visibility": "private"
    }
  },
  "navigation": {
    "label": "widgets.name",
    "items": [
      {
        "label": "widgets.overview",
        "route": "overview"
      },
      {
        "label": "widgets.new",
        "route": "editor"
      },
      {
        "label": "widgets.library",
        "route": "library"
      },
      {
        "label": "widgets.sets",
        "route": "sets"
      },
      {
        "separator": true
      },
      {
        "label": "widgets.history",
        "route": "history"
      },
      {
        "separator": true
      },
      {
        "label": "widgets.trash",
        "route": "trash"
      }
    ]
  },
  "configuration": false,
  "contentServices": {
    "set": {
      "api": 1,
      "description": "A reusable ordered widget set, independent of template positions.",
      "context": "block",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key"
        ],
        "properties": {
          "key": {
            "type": "string",
            "maxLength": 48
          }
        }
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "title",
                "text",
                "href",
                "image"
              ],
              "properties": {
                "title": {
                  "type": "string",
                  "maxLength": 12000
                },
                "text": {
                  "type": "string",
                  "maxLength": 12000
                },
                "href": {
                  "type": "string",
                  "maxLength": 12000
                },
                "image": {
                  "type": "string",
                  "maxLength": 12000
                }
              }
            }
          }
        }
      },
      "formats": [
        "list",
        "cards"
      ]
    },
    "value": {
      "api": 1,
      "description": "A reusable plain widget value for inline text.",
      "context": "text",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key"
        ],
        "properties": {
          "key": {
            "type": "string",
            "maxLength": 64
          }
        }
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "value"
        ],
        "properties": {
          "value": {
            "type": "string",
            "maxLength": 12000
          }
        }
      },
      "formats": [
        "text"
      ]
    },
    "records": {
      "api": 1,
      "description": "Ordered literal reusable Widget key/value/description records from a live set.",
      "context": "block",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key"
        ],
        "properties": {
          "key": {
            "type": "string",
            "maxLength": 48
          }
        }
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "key",
                "value",
                "description"
              ],
              "properties": {
                "key": {
                  "type": "string",
                  "maxLength": 48
                },
                "value": {
                  "type": "string",
                  "maxLength": 12000
                },
                "description": {
                  "type": "string",
                  "maxLength": 500
                }
              }
            }
          }
        }
      },
      "formats": [
        "data"
      ]
    }
  },
  "presentation": "about.json"
}

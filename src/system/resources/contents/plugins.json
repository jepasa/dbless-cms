{
  "schema_version": 1,
  "plugins": {
    "files-manager": {
      "enabled": true,
      "settings": {
        "uploads": {
          "public": "media",
          "private": "media"
        }
      }
    },
    "menu": {
      "enabled": true,
      "settings": {}
    },
    "pages": {
      "enabled": true,
      "settings": {}
    },
    "slides": {
      "enabled": true,
      "settings": {}
    },
    "blog": {
      "enabled": true,
      "settings": {
        "publication": {
          "title": "Journal",
          "description": "Ideas, practical guides and stories worth sharing.",
          "pageSize": 9,
          "feedLimit": 20,
          "readingSpeed": 200
        },
        "discussion": {
          "enabled": false,
          "maxLength": 2000
        }
      }
    },
    "widgets": {
      "enabled": true,
      "settings": {}
    }
  }
}

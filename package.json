{
  "name": "dbless-cms",
  "private": true,
  "version": "2.0.0",
  "description": "A database-free PHP CMS with JSON content, a focused admin panel and extensible templates and plugins.",
  "scripts": {
    "dev": "php -S 127.0.0.1:8080 -t src/public_html scripts/dev-router.php",
    "predev": "npm run init:contents",
    "init:contents": "php src/system/bin/init-contents.php",
    "lint": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "identity:check": "node scripts/check-identity.mjs",
    "verify": "npm run identity:check && npm run lint && npm test",
    "export:production": "node scripts/build.mjs",
    "security:audit": "npm audit --audit-level=high"
  },
  "devDependencies": {
    "clean-css": "^5.3.3",
    "html-minifier-terser": "^7.2.0",
    "terser": "^5.39.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jepasa/dbless-cms.git"
  },
  "license": "Apache-2.0"
}
